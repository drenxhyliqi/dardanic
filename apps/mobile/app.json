{
  "expo": {
    "name": "DARDANIC",
    "slug": "dardanic",
    "scheme": "dardanic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080B12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo-mark.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#080B12"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DARDANIC to access your photos so you can add them to your profile, chats and listings.",
          "cameraPermission": "Allow DARDANIC to use your camera so you can take photos to send in chats and listings.",
          "microphonePermission": false
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DARDANIC to use your camera so you can take photos and videos for your story.",
          "microphonePermission": "Allow DARDANIC to use your microphone so your story videos have sound.",
          "recordAudioAndroid": true
        }
      ]
    ]
  }
}
